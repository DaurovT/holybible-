[Unit]
Description=HolyBible AI backend
After=network-online.target
Wants=network-online.target

[Service]
User=travelproject
WorkingDirectory=/home/travelproject/holybible-server
EnvironmentFile=/home/travelproject/.holybible.env
ExecStart=/home/travelproject/holybible-server/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8099
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/travelproject/holybible-server

[Install]
WantedBy=multi-user.target
