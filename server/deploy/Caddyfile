# HolyBible AI backend. Наружу смотрит только этот прокси; сам бэкенд слушает
# 127.0.0.1:8099 и из интернета недоступен. Сертификат Caddy получает и
# продлевает сам — для этого и нужен открытый 80-й порт.
holybible-api.eastus.cloudapp.azure.com {
	encode zstd gzip

	# Ключ модели и общий секрет живут в бэкенде на 8099, прокси их не знает.
	reverse_proxy 127.0.0.1:8099
}
